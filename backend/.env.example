# =====================================================================
# Choose how ANSWERS are generated:  groq  (cloud, free key)  or  ollama (fully local)
# Embeddings always run locally (sentence-transformers). No API key needed for them.
# =====================================================================
LLM_PROVIDER=groq

# --- Option 1: Groq (get a free key at https://console.groq.com -> API Keys) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Higher daily free quota, slightly weaker answers: llama-3.1-8b-instant

# --- Option 2: Ollama (install from https://ollama.com, then: ollama pull llama3.1:8b) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192

# --- Embeddings (local; downloaded once, ~90 MB) ---
EMBEDDING_MODEL=sentence-transformers/multi-qa-MiniLM-L6-cos-v1

# --- RAG tuning ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
# Cosine similarity (0-1). Chunks scoring below this are discarded.
# Local MiniLM scores are lower than cloud models; 0.35 is a good start. Tune it.
RELEVANCE_THRESHOLD=0.35

# --- Uploads ---
MAX_UPLOAD_MB=15
MAX_CHUNKS_PER_DOCUMENT=5000
MAX_CSV_ROWS=20000

# --- Server ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATA_DIR=./data
